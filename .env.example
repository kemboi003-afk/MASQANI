# Shared
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# API
PORT=4000
# pglite is for local development only. Use postgres for every deployed environment.
DATABASE_DRIVER=pglite
LOCAL_DATABASE_PATH=.masqani-data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/masqani
JWT_SECRET=replace-with-a-strong-64-character-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# Google Authentication
GOOGLE_CLIENT_ID=

# OTP/SMS
OTP_EXPIRES_MINUTES=10
SMS_PROVIDER=demo
SMS_API_KEY=
SMS_SENDER_ID=MASQANI

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=masqani

# M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=http://localhost:4000/api/payments/mpesa/callback

# Card / Bank / Mobile money provider placeholders
PAYMENT_PROVIDER_SECRET=
BANK_PAYMENT_WEBHOOK_SECRET=
MOBILE_MONEY_WEBHOOK_SECRET=

# Email (Resend) and SMS (Twilio) notifications
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
